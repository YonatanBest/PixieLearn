APP_ENV=development
APP_NAME=PixieLearn API
FRONTEND_ORIGIN=http://localhost:8443
BETTER_AUTH_BASE_URL=http://127.0.0.1:3001
BETTER_AUTH_COOKIE_NAME=better-auth.session_token
BETTER_AUTH_TIMEOUT_SECONDS=5
DATABASE_URL=postgresql+psycopg://pixielearn:pixielearn@localhost:5432/pixielearn
REDIS_URL=redis://localhost:6410/0
OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9100
# The API runs on the host; document workers use MinIO directly inside Docker.
OBJECT_STORAGE_PUBLIC_ENDPOINT_URL=http://localhost:9100
OBJECT_STORAGE_REGION_NAME=us-east-1
OBJECT_STORAGE_BUCKET=pixielearn-documents
OBJECT_STORAGE_ACCESS_KEY_ID=pixielearn
OBJECT_STORAGE_SECRET_ACCESS_KEY=pixielearn-local-secret
OBJECT_STORAGE_CREATE_BUCKET_IF_MISSING=true
OBJECT_STORAGE_URL_TTL_SECONDS=300
DOCUMENT_MAX_SIZE_BYTES=104857600
DOCUMENT_CONVERSION_TIMEOUT_SECONDS=900
LIBREOFFICE_BINARY=libreoffice
TESSERACT_BINARY=tesseract
DOCUMENT_OCR_LANGUAGE=eng
DOCUMENT_OCR_DPI=300
# Optional OpenAI-compatible chat-completions endpoint for typed tutor questions.
# Configure URL, model, and provider credentials only on the API server.
AI_CHAT_COMPLETIONS_URL=
AI_API_KEY=
AI_MODEL=
AI_REQUEST_TIMEOUT_SECONDS=30
# Optional Meta Model API for grounded tutor answers and push-to-talk transcription.
# Keep provider keys on the API server; never expose them in frontend configuration.
META_MODEL_API_KEY=
META_MODEL=muse-spark-1.3
# Optional Gemini TTS for speaking saved tutor answers.
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
