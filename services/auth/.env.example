NODE_ENV=development
PORT=3001
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgres://pixielearn:pixielearn@localhost:5432/pixielearn
FRONTEND_URLS=http://localhost:8443
# Add each trusted browser origin, comma-separated, to allow LAN clients.
# Example: FRONTEND_URLS=http://localhost:8443,http://192.168.1.100:8443

# Optional. Google sign-in is enabled only when both values are configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
