# Frontend API origin. Keep /api to use the Vite split-service proxy.
VITE_API_URL=/api

# Keep true while the backend is unavailable. Set false to use the HTTP auth service.
VITE_ENABLE_MOCK_AUTH=true

# Optional local proxy targets for split services in development.
AUTH_PROXY_URL=http://127.0.0.1:3001
API_PROXY_URL=http://127.0.0.1:8000
